# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env

# @BotFather bergan token
BOT_TOKEN=
# botning username'i, @ belgisisiz (masalan my_movie_bot)
BOT_USERNAME=
# asosiy adminning Telegram ID raqami (@userinfobot orqali bilish mumkin)
ROOT_ADMIN_ID=
# kino ostida ko'rsatiladigan guruh/kanal (masalan @mygroup), bo'sh qoldirsa ham bo'ladi
BOT_GROUP_LINK=

# PostgreSQL paroli (Docker bilan ishlatilsa, baza shu parol bilan yaratiladi)
DB_PASSWORD=
# Docker'siz ishlatilsa, baza manzili va foydalanuvchisi
DB_URL=jdbc:postgresql://localhost:5432/moviebot
DB_USERNAME=postgres
